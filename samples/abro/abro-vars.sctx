scchart ABRO {
	input bool A, B, R
	output bool O

	initial state ABO {
		entry do O = false

		region Wait {
			initial state WaitAB {
				region A {
					initial state WaitA
					if A go to DoneA

					final state DoneA
				}
				
				region B {
					initial state WaitB
					if B go to DoneB

					final state DoneB
				}
			}
			do O = true join to Done

			state Done
		}
	}
	if R abort to ABO
}
